# Optional: without this key the local deterministic demo interpreter is used.
OPENROUTER_API_KEY=
GAINTT_DB_PATH=data/gaintt.sqlite
# Set true behind HTTPS; keep false for local http://127.0.0.1 development.
GAINTT_COOKIE_SECURE=false
MCP_HTTP_ENABLED=false
# Required only when MCP_HTTP_ENABLED=true; without it MCP stays read-only.
MCP_WRITE_TOKEN=
